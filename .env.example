# Optional credentials for a bounded cloud literature search.
# This file contains names only. Never commit populated credentials.
# Inject these variables through the runner's approved secret store.
# The CLI also reads ~/.config/lit-search/credentials.env (`lit-search config`).
# See docs/configuration.md#bounded-cloud-runs for aliases and a run command.

# semantic_scholar: HTTPS api.semanticscholar.org, x-api-key header
SEMANTIC_SCHOLAR_API_KEY=

# openalex: HTTPS api.openalex.org, api_key query parameter
OPENALEX_API_KEY=

# Optional search source; not included in the bounded two-source command.
# openaire: HTTPS api.openaire.eu, Authorization: Bearer header
OPENAIRE_ACCESS_TOKEN=

# OpenAIRE refresh: HTTPS services.openaire.eu, refreshToken query parameter
OPENAIRE_REFRESH_TOKEN=
